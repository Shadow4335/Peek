# Supabase project (Settings → API). Anon key is safe for the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Render game server (Socket.io + REST).
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000

# MapLibre style URL (any MapLibre-compatible vector style).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
