# Render injects PORT automatically in production.
PORT=4000
NODE_ENV=development

# Supabase project (Settings → API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Anon key: used to call client-facing RPCs *as the user* (their JWT), so auth.uid() checks apply.
SUPABASE_ANON_KEY=your-anon-key
# Service role key bypasses RLS — server only, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowed browser origins for CORS + Socket.io. "*" wildcards one subdomain label,
# e.g. https://*.vercel.app for preview deployments.
CORS_ORIGINS=http://localhost:3000

# Reconcile in-memory rooms with the database every N ms.
SWEEP_INTERVAL_MS=5000
