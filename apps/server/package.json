{
  "name": "@hideseek/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev:fake": "tsx watch test/devServer.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "@turf/turf": "^7",
    "cors": "^2",
    "express": "^5",
    "socket.io": "^4",
    "ws": "^8.22.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@hideseek/shared": "*",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/node": "^20",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "socket.io-client": "^4.8.4",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3.2.7"
  }
}
